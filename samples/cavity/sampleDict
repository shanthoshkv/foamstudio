FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      sampleDict;
}
// Sampling line. This is not a solver dictionary.

type            sets;
libs            (sampling);
setFormat       raw;
interpolationScheme cellPoint;
fields          (U);

sets
(
    vertical
    {
        type        uniform;
        axis        y;
        start       (0.5 0 0.05);
        end         (0.5 1 0.05);
        nPoints     201;
    }
);
