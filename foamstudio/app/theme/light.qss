QMainWindow, QDialog, QWidget {
    background: #f4f6f8;
    color: #1a1f24;
}
QMenuBar, QMenu, QStatusBar, QDockWidget {
    background: #ffffff;
    color: #1a1f24;
    border: none;
}
QMenuBar::item:selected, QMenu::item:selected, QMenu::item:hover {
    background: #007a50;
    color: #ffffff;
}
QDockWidget::title {
    background: #ffffff;
    padding: 6px 8px;
    color: #007a50;
    border: 1px solid #d5dbe0;
}
QTreeWidget, QPlainTextEdit, QTextEdit, QListWidget {
    background: #ffffff;
    color: #1a1f24;
    border: 1px solid #d5dbe0;
    selection-background-color: #d7f5ea;
    selection-color: #007a50;
}
QTreeWidget::item:selected {
    background: #d7f5ea;
    color: #007a50;
}
QTabWidget::pane {
    border: 1px solid #d5dbe0;
    background: #ffffff;
}
QTabBar::tab {
    background: #e8eef2;
    color: #4a5560;
    padding: 6px 12px;
    border: 1px solid #d5dbe0;
}
QTabBar::tab:selected {
    background: #ffffff;
    color: #007a50;
}
QSplitter::handle {
    background: #d5dbe0;
}
QLabel#placeholder {
    color: #4a5560;
}
QStatusBar {
    border-top: 1px solid #d5dbe0;
}

/* ---- widgets that had no theme: inputs, buttons, tables, scrollbars ---- */
QPlainTextEdit, QTextEdit {
    font-family: "Cascadia Mono", "JetBrains Mono", "Consolas", "Menlo", "DejaVu Sans Mono", monospace;
}
QLabel {
    background: transparent;
}
QPushButton {
    background: #eef1f4;
    color: #1a1f24;
    border: 1px solid #c9d1d8;
    border-radius: 4px;
    padding: 6px 14px;
}
QPushButton:hover {
    border-color: #007a50;
    color: #007a50;
}
QPushButton:pressed {
    background: #007a50;
    color: #ffffff;
}
QPushButton:disabled {
    color: #9aa3ab;
    border-color: #c9d1d8;
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: #ffffff;
    color: #1a1f24;
    border: 1px solid #c9d1d8;
    border-radius: 4px;
    padding: 4px 6px;
    min-height: 20px;
    selection-background-color: #d7f5ea;
    selection-color: #1a1f24;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #007a50;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    color: #9aa3ab;
}
QComboBox QAbstractItemView {
    background: #ffffff;
    color: #1a1f24;
    border: 1px solid #c9d1d8;
    selection-background-color: #d7f5ea;
    selection-color: #007a50;
}
QTableWidget, QTableView {
    background: #ffffff;
    color: #1a1f24;
    gridline-color: #c9d1d8;
    border: 1px solid #c9d1d8;
}
QHeaderView::section {
    background: #eef1f4;
    color: #5b6670;
    border: none;
    border-bottom: 1px solid #c9d1d8;
    padding: 4px 6px;
}
QTreeWidget::item, QListWidget::item {
    padding: 3px 2px;
}
QToolTip {
    background: #eef1f4;
    color: #1a1f24;
    border: 1px solid #c9d1d8;
    padding: 4px;
}
QScrollBar:vertical, QScrollBar:horizontal {
    background: #f4f6f8;
    border: none;
    width: 10px;
    height: 10px;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #c9d1d8;
    border-radius: 4px;
    min-height: 24px;
    min-width: 24px;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}
